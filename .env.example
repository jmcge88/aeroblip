# Demo mode: fabricate overhead traffic AND board data (no API keys or live
# traffic needed). When false, data is never made up.
DEMO_MODE=false

# Product mode: the hosted/commercial deployment. Locks data sources to
# commercially-licensed ones (adsb.lol positions under ODbL, AeroDataBox
# metadata, no planespotters photos). Leave false for personal/self-hosted use.
PRODUCT_MODE=false

# Default location (decimal degrees) - used by the web dashboard and by any
# device that hasn't set its own location in its WiFi portal. Devices send
# their own lat/lon/radii/airport as query params and get their own sky.
HOME_LAT=-27.3842
HOME_LON=153.1175

# Flights within OVERHEAD_RADIUS_NM of home get the big "spotlight" view.
# Anything within AREA_RADIUS_NM shows on the nearby-traffic list; when that
# is empty too, the airport departures/arrivals board is shown.
OVERHEAD_RADIUS_NM=5
AREA_RADIUS_NM=60

# Default airport for the arrivals/departures board
AIRPORT_ICAO=YBBN
AIRPORT_IATA=BNE
AIRPORT_NAME=Brisbane

# Radar source: adsblol | adsbfi (auto-fallback if one is down)
# adsb.lol rate-limits at roughly 1 req/10s, so the poller spaces its calls and
# sticks to whichever source last worked. airplanes.live used to be an option
# here; they closed the public API in Aug 2026 and now 403 every request.
# PRODUCT_MODE ignores this and always uses adsblol (adsb.fi is
# non-commercial); consider POLL_SECONDS=8+ there and mind MAX_LOCATIONS.
ADSB_PROVIDER=adsblol
POLL_SECONDS=5

# Cap on concurrently-polled device locations (each is its own upstream loop).
# At the cap the least-recently-used location with no live websocket client is
# evicted, so nobody can lock the fleet out by walking arbitrary coordinates.
MAX_LOCATIONS=50

# Cap on concurrently-refreshed airport boards. Each distinct airport code costs
# AeroDataBox calls for as long as it lives, and codes come straight from a
# query param - so this is a spend limit. Raise it only if you genuinely serve
# devices at more than this many airports.
MAX_AIRPORTS=20

# AeroDataBox key: airport board always; aircraft metadata + routes in
# PRODUCT_MODE (paid plan required there - see aerodatabox.com/pricing).
# Leave blank and the board shows "no data" (or set DEMO_MODE=true for fake data).
# Get a key at https://rapid.aerodatabox.com/ or https://apimarket.aerodatabox.com/
AERODATABOX_API_KEY=
AERODATABOX_MARKET=rapidapi
BOARD_REFRESH_MINUTES=20

# Don't refresh the board between these local hours (saves free-tier calls)
BOARD_QUIET_START=23
BOARD_QUIET_END=5

# Airline logos, served via /api/logo/{iata} with a 30-day server-side cache.
# Personal default: kiwi.com hotlink. Product default: logostream.dev (free
# tier includes commercial use; sign up for a key and set it here).
# logostream only accepts the key in the URL, so the template uses {key};
# LOGO_API_KEY_HEADER applies only to templates without a {key} placeholder.
#LOGO_URL_TEMPLATE=https://airlines-api.logostream.dev/airlines/iata/{code}?key={key}
LOGO_API_KEY=
LOGO_API_KEY_HEADER=X-API-Key

# Device fleet (product deployments): require a provisioned per-device token
# on the data endpoints, and protect registration with an admin token.
REQUIRE_DEVICE_TOKEN=false
ADMIN_TOKEN=

# Writable state (device registry, logo cache) and OTA firmware images
DATA_DIR=data
FW_DIR=fw

TZ=Australia/Brisbane
